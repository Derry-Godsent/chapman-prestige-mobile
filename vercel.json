{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/booking/:id",
      "destination": "/booking/[id].html"
    },
    {
      "source": "/service/:id",
      "destination": "/service/[id].html"
    },
    {
      "source": "/booking/:id/",
      "destination": "/booking/[id].html"
    },
    {
      "source": "/service/:id/",
      "destination": "/service/[id].html"
    }
  ]
}
